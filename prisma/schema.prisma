generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
}

enum EstadoTurno {
  PENDIENTE_PAGO
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

enum MetodoPago {
  MERCADOPAGO
  TRANSFERENCIA
  EFECTIVO
  SIN_PAGO
}

model Profesional {
  id               String              @id @default(cuid())
  clerkUserId      String              @unique
  email            String
  nombre           String
  slug             String              @unique
  descripcion      String?
  fotoUrl          String?
  telefono         String?
  timezone         String              @default("America/Argentina/Buenos_Aires")
  plan             Plan                @default(FREE)
  mpAccessToken    String?
  mpUserId         String?
  mpPublicKey      String?
  mpSubscriptionId String?
  planExpiresAt    DateTime?
  servicios        Servicio[]
  miembros         Miembro[]
  horarios         HorarioDisponible[]
  bloqueos         Bloqueo[]
  turnos           Turno[]
  datosBancarios   DatosBancarios?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([slug])
}

model Servicio {
  id              String      @id @default(cuid())
  profesional     Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  profesionalId   String
  nombre          String
  descripcion     String?
  duracionMinutos Int
  precio          Decimal     @db.Decimal(10, 2)
  moneda          String      @default("ARS")
  requierePago    Boolean     @default(false)
  metodoPago      MetodoPago  @default(MERCADOPAGO)
  activo          Boolean     @default(true)
  turnos          Turno[]
  miembros        MiembroServicio[]
  createdAt       DateTime    @default(now())

  @@index([profesionalId])
}

/**
 * Persona del equipo que presta servicios (peluquero/a, profesional de salud,
 * etc.). Pertenece a una cuenta (`Profesional`, que actúa como
 * establecimiento). Para cuentas monopersona existe un único miembro creado
 * automáticamente que representa al dueño.
 */
model Miembro {
  id            String            @id @default(cuid())
  profesional   Profesional       @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  profesionalId String
  nombre        String
  fotoUrl       String?
  activo        Boolean           @default(true)
  servicios     MiembroServicio[]
  turnos        Turno[]
  createdAt     DateTime          @default(now())

  @@index([profesionalId])
}

/** Relación N:N entre un miembro del equipo y los servicios que puede prestar. */
model MiembroServicio {
  miembro    Miembro  @relation(fields: [miembroId], references: [id], onDelete: Cascade)
  miembroId  String
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  servicioId String

  @@id([miembroId, servicioId])
  @@index([servicioId])
}

model HorarioDisponible {
  id            String      @id @default(cuid())
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  profesionalId String
  diaSemana     Int
  horaInicio    String
  horaFin       String

  @@index([profesionalId])
}

model Bloqueo {
  id            String      @id @default(cuid())
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  profesionalId String
  fechaInicio   DateTime
  fechaFin      DateTime
  motivo        String?

  @@index([profesionalId, fechaInicio])
}

model Turno {
  id                     String      @id @default(cuid())
  profesional            Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  profesionalId          String
  servicio               Servicio    @relation(fields: [servicioId], references: [id])
  servicioId             String
  miembro                Miembro?    @relation(fields: [miembroId], references: [id])
  miembroId              String?
  clienteNombre          String
  clienteTelefono        String
  clienteEmail           String?
  fechaInicio            DateTime
  fechaFin               DateTime
  estado                 EstadoTurno @default(CONFIRMADO)
  mpPaymentId            String?
  mpPreferenceId         String?
  mpInitPoint            String?
  recordatorio24hEnviado Boolean     @default(false)
  recordatorio1hEnviado  Boolean     @default(false)
  cancelToken            String?     @unique
  notas                  String?
  createdAt              DateTime    @default(now())

  @@index([profesionalId, fechaInicio])
  @@index([miembroId, fechaInicio])
  @@index([estado, fechaInicio])
}

model DatosBancarios {
  id            String      @id @default(cuid())
  profesional   Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  profesionalId String      @unique
  cbu           String?
  alias         String?
  banco         String?
  titular       String?
  cuit          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model EventoWebhook {
  id          String   @id @default(cuid())
  proveedor   String
  externalId  String
  payload     Json
  procesadoAt DateTime @default(now())

  @@unique([proveedor, externalId])
}
